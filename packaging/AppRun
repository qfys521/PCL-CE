#!/bin/sh
# PCL-CE-Linux AppRun — entry point executed by the AppImage runtime.
#
# The launcher is a self-contained .NET application: it needs no system .NET,
# Mono or Wine.  This wrapper only makes the contents of the AppDir visible to
# the process (bundled CJK font, hicolor icon theme, desktop/MIME metadata) and
# then execs the real apphost.  It never writes inside $APPDIR: the AppImage is
# mounted read-only.

set -eu

# --- locate the AppDir -----------------------------------------------------
# APPIMAGE runtimes export $APPDIR; when the AppDir was extracted manually
# ("--appimage-extract", no-FUSE fallback) derive it from the script location.
if [ -z "${APPDIR:-}" ]; then
    _self="$0"
    while [ -L "$_self" ]; do
        _target=$(readlink "$_self")
        case "$_target" in
            /*) _self="$_target" ;;
            *)  _self="$(dirname "$_self")/$_target" ;;
        esac
    done
    APPDIR=$(CDPATH= cd -- "$(dirname -- "$_self")" && pwd)
    export APPDIR
fi

# --- bundled fonts ---------------------------------------------------------
# Noto Sans CJK SC (Regular/Bold) is shipped inside the AppImage so Chinese
# text renders even on hosts without any CJK font installed.
#
# The AppImage mount path changes on every launch, so pointing FONTCONFIG_FILE
# directly at $APPDIR would rebuild the fontconfig cache every launch.  On some
# systems that rebuild races with SkiaSharp's bundled HarfBuzz and aborts the
# process ("free(): invalid pointer").  Copy the fonts once to a stable
# per-user directory and generate a stable fonts.conf there.
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
app_cache="$cache_home/pcl-ce"
mkdir -p "$app_cache"

app_version=$(sed -n 's/^PCL-CE-Linux \([0-9][0-9.]*\).*/\1/p' \
    "$APPDIR/usr/share/doc/pcl-ce/BUILD-INFO.txt" 2>/dev/null | head -n 1 || true)
[ -n "${app_version:-}" ] || app_version=1.0.0
font_dir="$app_cache/bundled-fonts-$app_version"
font_conf="$app_cache/fonts-$app_version.conf"

if [ ! -d "$font_dir" ] || [ -z "$(ls -A "$font_dir" 2>/dev/null)" ]; then
    rm -rf "$font_dir"
    mkdir -p "$font_dir"
    cp -f "$APPDIR/usr/share/fonts/opentype/noto-cjk/"*.otf "$font_dir"/ 2>/dev/null || true
fi

if [ ! -f "$font_conf" ]; then
    {
        echo '<?xml version="1.0"?>'
        echo '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">'
        echo '<fontconfig>'
        echo "  <dir>$font_dir</dir>"
        echo '  <dir>~/.fonts</dir>'
        echo '  <dir prefix="xdg">fonts</dir>'
        echo '  <dir>/usr/local/share/fonts</dir>'
        echo '  <dir>/usr/share/fonts</dir>'
        echo '  <cachedir prefix="xdg">pcl-ce/fontconfig</cachedir>'
        echo '  <include ignore_missing="yes">/etc/fonts/conf.d</include>'
        echo '</fontconfig>'
    } > "$font_conf"
fi
export FONTCONFIG_FILE="$font_conf"

# Build the fontconfig cache once, in a separate process: never inside the
# launcher where SkiaSharp's HarfBuzz is already loaded.  The launcher performs
# the same prewarm through fontconfig directly if fc-cache is unavailable.
font_cache="$cache_home/pcl-ce/fontconfig"
if [ ! -d "$font_cache" ] || [ -z "$(ls -A "$font_cache" 2>/dev/null)" ] \
   || [ -n "$(find /usr/share/fonts /usr/local/share/fonts -newer "$font_cache" -print -quit 2>/dev/null)" ]; then
    if command -v fc-cache >/dev/null 2>&1; then
        fc-cache -f >/dev/null 2>&1 || true
    fi
fi

# --- bundled icon theme / desktop metadata --------------------------------
# The AppImage ships hicolor icons (16..512 px), its .desktop file and the MIME
# definitions.  Prepending usr/share lets GTK/Qt/X11 integrations find them
# without installing anything on the host.
if [ -n "${XDG_DATA_DIRS:-}" ]; then
    export XDG_DATA_DIRS="$APPDIR/usr/share:$XDG_DATA_DIRS"
else
    export XDG_DATA_DIRS="$APPDIR/usr/share:/usr/local/share:/usr/share"
fi

# Make the launcher available under its desktop Exec name (usr/bin/PCL-CE).
if [ -n "${PATH:-}" ]; then
    export PATH="$APPDIR/usr/bin:$PATH"
else
    export PATH="$APPDIR/usr/bin:/usr/local/bin:/usr/bin:/bin"
fi

# The apphost and its entire runtime live in the same directory
# (usr/lib/pcl-ce), so it resolves PCL-CE.dll and native libraries by itself.
exec "$APPDIR/usr/lib/pcl-ce/PCL-CE" "$@"
