<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>PCL-CE</AssemblyName>
        <RootNamespace>PCL.Linux</RootNamespace>
        <LangVersion>15.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>1.0.0</Version>
        <AssemblyTitle>PCL-CE-Linux</AssemblyTitle>
        <Product>PCL-CE-Linux</Product>
        <Company>PCL Community / PCL-CE-Linux contributors</Company>
        <Description>PCL CE 的 Linux 原生版本</Description>
        <ApplicationIcon>../Plain Craft Launcher 2/Images/icon.ico</ApplicationIcon>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
        <ProjectReference Include="../PCL.Launcher.Core/PCL.Launcher.Core.csproj" />
        <EmbeddedResource Include="../Plain Craft Launcher 2/metadata.json" LogicalName="PCL.metadata.json" />
        <!-- 原版 lucide 图标资源（与 PCL CE 完全一致） -->
        <EmbeddedResource Include="Assets/Icons/Lucide/*.svg" LogicalName="PCL.Icons.%(Filename)%(Extension)" />
        <!-- 原版 PCL English 字体（UI 拉丁字母与数字的圆体） -->
        <AvaloniaResource Include="Assets/Fonts/PCLEnglish.ttf" />
        <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="../PCL.Launcher.Core/LICENCE" Link="LICENCE-launcher" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="README.md" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="pcl-ce.desktop" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="../Plain Craft Launcher 2/Images/Heads/Logo-CE.png" Link="pcl-ce.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="../Plain Craft Launcher 2/Images/**/*" Link="Images/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
